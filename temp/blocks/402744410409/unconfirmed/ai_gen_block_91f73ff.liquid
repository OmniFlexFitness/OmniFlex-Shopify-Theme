{% doc %}
  @prompt
    Create a new version of the "Featured product" section, but instead of the normal product image, allow for a 3D rotating product image to be featured, with a stage that fits the cyberpunk/vapourwave/neon-noire aesthetic for the product display. Also make sure that the rotation of the platform is interactive., Try to make it fit the neon-noire aesthetic more, and avoid using gradients like in the current one
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-featured-product-3d-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background: {{ block.settings.background_color }};
    padding: {{ block.settings.section_padding }}px 20px;
    position: relative;
    overflow: hidden;
  }

  .ai-featured-product-3d-{{ ai_gen_id }}::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 20%;
    width: 300px;
    height: 300px;
    background: {{ block.settings.glow_color_1 }};
    opacity: 0.15;
    filter: blur(100px);
    border-radius: 50%;
    pointer-events: none;
    z-index: 0;
  }

  .ai-featured-product-3d-{{ ai_gen_id }}::after {
    content: '';
    position: absolute;
    top: 50%;
    right: 20%;
    width: 300px;
    height: 300px;
    background: {{ block.settings.glow_color_2 }};
    opacity: 0.15;
    filter: blur(100px);
    border-radius: 50%;
    pointer-events: none;
    z-index: 0;
  }

  .ai-featured-product-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.desktop_width_percent }}%;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: center;
    position: relative;
    z-index: 1;
  }

  .ai-featured-product-stage-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    aspect-ratio: 1;
    perspective: 1000px;
  }

  .ai-featured-product-platform-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: 100%;
    transform-style: preserve-3d;
    transition: transform 0.1s ease-out;
  }

  .ai-featured-product-base-{{ ai_gen_id }} {
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%) rotateX(75deg);
    width: 80%;
    height: 80%;
    background: {{ block.settings.platform_color }};
    border-radius: 50%;
    border: 3px solid {{ block.settings.platform_border_color }};
    box-shadow: 
      0 0 60px {{ block.settings.glow_color_1 }}80,
      0 0 100px {{ block.settings.glow_color_2 }}40,
      inset 0 -20px 40px rgba(0, 0, 0, 0.5);
  }

  .ai-featured-product-grid-{{ ai_gen_id }} {
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%) rotateX(75deg);
    width: 80%;
    height: 80%;
    border-radius: 50%;
    background-image: 
      repeating-linear-gradient(0deg, {{ block.settings.grid_color }} 0px, transparent 1px, transparent {{ block.settings.grid_spacing }}px),
      repeating-linear-gradient(90deg, {{ block.settings.grid_color }} 0px, transparent 1px, transparent {{ block.settings.grid_spacing }}px);
    opacity: {{ block.settings.grid_opacity }};
  }

  .ai-featured-product-scanline-{{ ai_gen_id }} {
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%) rotateX(75deg);
    width: 80%;
    height: 2px;
    background: {{ block.settings.scanline_color }};
    box-shadow: 0 0 20px {{ block.settings.scanline_color }};
    opacity: 0.8;
    animation: ai-scanline-{{ ai_gen_id }} 4s linear infinite;
  }

  @keyframes ai-scanline-{{ ai_gen_id }} {
    0% {
      bottom: 0;
      opacity: 0;
    }
    10% {
      opacity: 0.8;
    }
    90% {
      opacity: 0.8;
    }
    100% {
      bottom: 80%;
      opacity: 0;
    }
  }

  .ai-featured-product-image-wrapper-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -60%);
    width: 70%;
    height: 70%;
    display: flex;
    align-items: center;
    justify-content: center;
    filter: drop-shadow(0 20px 40px {{ block.settings.glow_color_1 }}80);
  }

  .ai-featured-product-image-{{ ai_gen_id }} {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }

  .ai-featured-product-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid {{ block.settings.platform_border_color }};
    border-radius: 8px;
    position: relative;
  }

  .ai-featured-product-image-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.2;
  }

  .ai-featured-product-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: {{ block.settings.text_color }};
    opacity: 0.5;
    text-align: center;
    pointer-events: none;
  }

  .ai-featured-product-rings-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .ai-featured-product-ring-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%) rotateX(75deg);
    border-radius: 50%;
    border: 1px solid;
    opacity: 0.4;
  }

  .ai-featured-product-ring-{{ ai_gen_id }}:nth-child(1) {
    width: 90%;
    height: 90%;
    border-color: {{ block.settings.glow_color_1 }};
  }

  .ai-featured-product-ring-{{ ai_gen_id }}:nth-child(2) {
    width: 100%;
    height: 100%;
    border-color: {{ block.settings.glow_color_2 }};
  }

  .ai-featured-product-ring-{{ ai_gen_id }}:nth-child(3) {
    width: 110%;
    height: 110%;
    border-color: {{ block.settings.accent_color }};
    opacity: 0.2;
  }

  .ai-featured-product-info-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
  }

  .ai-featured-product-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    font-weight: 700;
    margin: 0 0 16px;
    color: {{ block.settings.title_color }};
    text-transform: uppercase;
    letter-spacing: 2px;
    text-shadow: 0 0 30px {{ block.settings.glow_color_1 }}60;
  }

  .ai-featured-product-vendor-{{ ai_gen_id }} {
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 3px;
    margin-bottom: 12px;
    color: {{ block.settings.accent_color }};
    font-weight: 600;
  }

  .ai-featured-product-price-{{ ai_gen_id }} {
    font-size: {{ block.settings.price_size }}px;
    font-weight: 700;
    margin-bottom: 24px;
    color: {{ block.settings.price_color }};
    text-shadow: 0 0 20px {{ block.settings.price_color }}60;
  }

  .ai-featured-product-description-{{ ai_gen_id }} {
    font-size: 16px;
    line-height: 1.8;
    margin-bottom: 32px;
    opacity: 0.85;
    font-weight: 300;
  }

  .ai-featured-product-button-{{ ai_gen_id }} {
    display: inline-block;
    padding: 16px 48px;
    background: {{ block.settings.button_color }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.button_radius }}px;
    font-weight: 700;
    font-size: 14px;
    text-transform: uppercase;
    letter-spacing: 2px;
    border: 2px solid {{ block.settings.button_border_color }};
    box-shadow: 
      0 0 30px {{ block.settings.button_border_color }}60,
      inset 0 0 20px {{ block.settings.button_border_color }}20;
    transition: all 0.3s ease;
    cursor: pointer;
    position: relative;
    overflow: hidden;
  }

  .ai-featured-product-button-{{ ai_gen_id }}::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: {{ block.settings.button_border_color }};
    opacity: 0.2;
    transition: left 0.3s ease;
  }

  .ai-featured-product-button-{{ ai_gen_id }}:hover::before {
    left: 100%;
  }

  .ai-featured-product-button-{{ ai_gen_id }}:hover {
    transform: translateY(-2px);
    box-shadow: 
      0 0 40px {{ block.settings.button_border_color }}80,
      inset 0 0 30px {{ block.settings.button_border_color }}30;
  }

  @media screen and (max-width: 749px) {
    .ai-featured-product-container-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .ai-featured-product-title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.title_size }}px * 0.7);
    }

    .ai-featured-product-price-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.price_size }}px * 0.8);
    }
  }
{% endstyle %}

<featured-product-3d-{{ ai_gen_id }}
  class="ai-featured-product-3d-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-featured-product-container-{{ ai_gen_id }}">
    <div class="ai-featured-product-stage-{{ ai_gen_id }}">
      <div class="ai-featured-product-platform-{{ ai_gen_id }}" data-platform>
        <div class="ai-featured-product-base-{{ ai_gen_id }}"></div>
        <div class="ai-featured-product-grid-{{ ai_gen_id }}"></div>
        {% if block.settings.show_scanline %}
          <div class="ai-featured-product-scanline-{{ ai_gen_id }}"></div>
        {% endif %}
        
        <div class="ai-featured-product-rings-{{ ai_gen_id }}">
          <div class="ai-featured-product-ring-{{ ai_gen_id }}"></div>
          <div class="ai-featured-product-ring-{{ ai_gen_id }}"></div>
          <div class="ai-featured-product-ring-{{ ai_gen_id }}"></div>
        </div>

        <div class="ai-featured-product-image-wrapper-{{ ai_gen_id }}">
          {% if block.settings.product and block.settings.product.featured_image %}
            <img
              src="{{ block.settings.product.featured_image | image_url: width: 800 }}"
              alt="{{ block.settings.product.featured_image.alt | escape }}"
              class="ai-featured-product-image-{{ ai_gen_id }}"
              loading="lazy"
              width="800"
              height="800"
            >
          {% else %}
            <div class="ai-featured-product-image-placeholder-{{ ai_gen_id }}">
              {{ 'product-1' | placeholder_svg_tag }}
              <div class="ai-featured-product-empty-state-{{ ai_gen_id }}">
                Select a product to display
              </div>
            </div>
          {% endif %}
        </div>
      </div>
    </div>

    <div class="ai-featured-product-info-{{ ai_gen_id }}">
      {% if block.settings.show_vendor and block.settings.product.vendor != blank %}
        <div class="ai-featured-product-vendor-{{ ai_gen_id }}">
          {{ block.settings.product.vendor }}
        </div>
      {% endif %}

      <h2 class="ai-featured-product-title-{{ ai_gen_id }}">
        {% if block.settings.product %}
          {{ block.settings.product.title }}
        {% else %}
          Featured Product
        {% endif %}
      </h2>

      {% if block.settings.product %}
        <div class="ai-featured-product-price-{{ ai_gen_id }}">
          {{ block.settings.product.price | money }}
        </div>
      {% endif %}

      {% if block.settings.show_description and block.settings.product.description != blank %}
        <div class="ai-featured-product-description-{{ ai_gen_id }}">
          {{ block.settings.product.description | strip_html | truncate: 200 }}
        </div>
      {% endif %}

      {% if block.settings.product %}
        <a
          href="{{ block.settings.product.url }}"
          class="ai-featured-product-button-{{ ai_gen_id }}"
        >
          {{ block.settings.button_text }}
        </a>
      {% endif %}
    </div>
  </div>
</featured-product-3d-{{ ai_gen_id }}>

<script>
  (function() {
    class FeaturedProduct3D{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.platform = null;
        this.isRotating = false;
        this.rotationX = 0;
        this.rotationY = 0;
        this.targetRotationX = 0;
        this.targetRotationY = 0;
        this.autoRotateSpeed = {{ block.settings.auto_rotate_speed }};
        this.sensitivity = {{ block.settings.rotation_sensitivity }};
      }

      connectedCallback() {
        this.platform = this.querySelector('[data-platform]');
        if (!this.platform) return;

        this.setupEventListeners();
        this.startAutoRotation();
      }

      setupEventListeners() {
        this.platform.addEventListener('mousedown', this.handleMouseDown.bind(this));
        this.platform.addEventListener('touchstart', this.handleTouchStart.bind(this), { passive: false });
        
        document.addEventListener('mousemove', this.handleMouseMove.bind(this));
        document.addEventListener('touchmove', this.handleTouchMove.bind(this), { passive: false });
        
        document.addEventListener('mouseup', this.handleMouseUp.bind(this));
        document.addEventListener('touchend', this.handleTouchEnd.bind(this));

        this.platform.addEventListener('mouseenter', () => {
          this.stopAutoRotation();
        });

        this.platform.addEventListener('mouseleave', () => {
          if (!this.isRotating) {
            this.startAutoRotation();
          }
        });
      }

      handleMouseDown(e) {
        this.isRotating = true;
        this.lastX = e.clientX;
        this.lastY = e.clientY;
        this.stopAutoRotation();
        e.preventDefault();
      }

      handleTouchStart(e) {
        this.isRotating = true;
        this.lastX = e.touches[0].clientX;
        this.lastY = e.touches[0].clientY;
        this.stopAutoRotation();
        e.preventDefault();
      }

      handleMouseMove(e) {
        if (!this.isRotating) return;

        const deltaX = e.clientX - this.lastX;
        const deltaY = e.clientY - this.lastY;

        this.targetRotationY += deltaX * this.sensitivity;
        this.targetRotationX -= deltaY * this.sensitivity * 0.5;

        this.targetRotationX = Math.max(-30, Math.min(30, this.targetRotationX));

        this.lastX = e.clientX;
        this.lastY = e.clientY;

        this.updateRotation();
      }

      handleTouchMove(e) {
        if (!this.isRotating) return;

        const deltaX = e.touches[0].clientX - this.lastX;
        const deltaY = e.touches[0].clientY - this.lastY;

        this.targetRotationY += deltaX * this.sensitivity;
        this.targetRotationX -= deltaY * this.sensitivity * 0.5;

        this.targetRotationX = Math.max(-30, Math.min(30, this.targetRotationX));

        this.lastX = e.touches[0].clientX;
        this.lastY = e.touches[0].clientY;

        this.updateRotation();
        e.preventDefault();
      }

      handleMouseUp() {
        this.isRotating = false;
        this.startAutoRotation();
      }

      handleTouchEnd() {
        this.isRotating = false;
        this.startAutoRotation();
      }

      updateRotation() {
        this.rotationX += (this.targetRotationX - this.rotationX) * 0.1;
        this.rotationY += (this.targetRotationY - this.rotationY) * 0.1;

        this.platform.style.transform = `rotateX(${this.rotationX}deg) rotateY(${this.rotationY}deg)`;
      }

      startAutoRotation() {
        if (this.autoRotateInterval) return;
        
        this.autoRotateInterval = setInterval(() => {
          if (!this.isRotating) {
            this.targetRotationY += this.autoRotateSpeed;
            this.updateRotation();
          }
        }, 16);
      }

      stopAutoRotation() {
        if (this.autoRotateInterval) {
          clearInterval(this.autoRotateInterval);
          this.autoRotateInterval = null;
        }
      }

      disconnectedCallback() {
        this.stopAutoRotation();
      }
    }

    customElements.define('featured-product-3d-{{ ai_gen_id }}', FeaturedProduct3D{{ ai_gen_id }});
  })();
</script>

